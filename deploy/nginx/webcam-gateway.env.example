# The host administrator installs and edits /etc/nginx/webcam-gateway.env (root, mode 600).
# Copy the exact assigned EWC DNS name; do not use the VM's .novalocal hostname.
UI_HOSTNAME=''
# Public/floating IP used for DNS verification only, never certificate issuance.
PUBLIC_IP='203.0.113.10'
UI_UPSTREAM='http://127.0.0.1:8080'
CERT_EMAIL='operator@example.org'
